# Copy to .env and fill in the keys you use. .env is gitignored.
# muxon reads the nearest .env at or above the current directory, up to the
# repo root. Variables already set in your shell take precedence.

# OpenCode Go (task eval, /providers in the TUI)
OPENCODE_API_KEY=

# DeepInfra (default worker role, weekly CI eval matrix)
DEEPINFRA_API_KEY=

# OpenAI
OPENAI_API_KEY=
